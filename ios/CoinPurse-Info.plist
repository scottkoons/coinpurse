<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HTTPS only, standard Apple encryption: exempt from export paperwork. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Press and hold the app icon. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>pinSpot</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Pin My Spot</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>mappin.and.ellipse</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>voiceNote</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Voice Note</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>mic.fill</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>addPicture</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Add Picture</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>camera.fill</string>
		</dict>
	</array>
	<!-- If Precise Location is off, a pin asks for it once, with this reason. -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>PinYourSpot</key>
		<string>Coin Purse needs your precise location for this pin, so you can find your way back to the exact spot.</string>
	</dict>
	<!-- Lets debug builds reach a local test server; all real traffic is HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
